<Window x:Class="CowClient.Launcher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="CowClient" Width="1180" Height="760" MinWidth="1000" MinHeight="700"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
 Background="#101310" Foreground="#EFEFDF" FontFamily="Segoe UI"
 TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="20"/></shell:WindowChrome.WindowChrome>
 <Border CornerRadius="20" BorderThickness="1" BorderBrush="#303A29" Background="#101310">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#171B16" CornerRadius="20,0,0,20"/>
  <Grid Grid.Column="0" Margin="16,20,16,20">
   <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="110"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal"><Image Source="Assets/cow.png" Width="49" Height="50"/><TextBlock Text="cowclient" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
   <StackPanel Grid.Row="1">
    <TextBlock Text="PLAY" FontSize="10" Foreground="{StaticResource Muted}" Margin="12,10,0,20"/>
    <Button Content="Home" HorizontalContentAlignment="Left" Click="Home_Click" Margin="0,0,0,10"/>
    <Button Content="Profiles" HorizontalContentAlignment="Left" Click="Profiles_Click" Background="Transparent" Margin="0,0,0,10"/>
    <Button Content="Settings" HorizontalContentAlignment="Left" Click="Settings_Click" Background="Transparent"/>
    <TextBlock Text="YOUR SPACE" FontSize="10" Foreground="{StaticResource Muted}" Margin="12,80,0,20"/>
    <Button Content="Open game folder" FontSize="12" HorizontalContentAlignment="Left" Click="Folder_Click" Background="Transparent" Margin="0,0,0,10"/>
    <Button Content="Build notes" FontSize="12" HorizontalContentAlignment="Left" Click="Notes_Click" Background="Transparent"/>
   </StackPanel>
   <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
    <Border Background="#22271E" CornerRadius="14" Padding="13,12">
     <StackPanel>
      <TextBlock x:Name="AccountName" Text="Microsoft account" FontSize="12" TextTrimming="CharacterEllipsis"/>
      <Button x:Name="LoginButton" Content="Sign in to play" FontSize="12" HorizontalContentAlignment="Left" Padding="0,10,0,2" Background="Transparent" Foreground="#C3ED91" Click="Login_Click"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </Grid>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="108"/><RowDefinition Height="*"/><RowDefinition Height="92"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="Title_Drag" Background="Transparent">
    <StackPanel Margin="36,29,100,0"><TextBlock Text="Make yourself at home." FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Minecraft, with a little more you." Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel>
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,14,15,0">
     <Button Content="—" ToolTip="Minimize" Background="Transparent" Padding="12,6" Click="Minimize_Click"/>
     <Button Content="×" ToolTip="Close" Background="Transparent" FontSize="20" Padding="12,2" Click="Close_Click"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="36,16,36,0">
    <Grid x:Name="HomePanel">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="188"/></Grid.RowDefinitions>
     <Border Background="#293A26" CornerRadius="20" ClipToBounds="True">
      <Grid Margin="30">
       <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="COWCLIENT  /  EARLY ACCESS" FontSize="11" FontWeight="SemiBold" Foreground="#CBDDB8"/>
        <TextBlock Text="Settle in.&#10;Play your way." FontSize="44" FontWeight="SemiBold" LineHeight="55" Margin="0,22,0,18"/>
        <TextBlock Text="Your HUD. Your setup. Your next session." Foreground="#B7C8AB" FontSize="13"/>
        <Button Content="Explore your setup" HorizontalAlignment="Left" Background="#ECEFDD" Foreground="#192316" Margin="0,25,0,0" Click="Profiles_Click"/>
       </StackPanel>
       <Image Grid.Column="1" Source="Assets/cow.png" VerticalAlignment="Center" Margin="0,20,0,0"/>
      </Grid>
     </Border>
     <StackPanel Grid.Row="1" Margin="0,25,0,0">
      <TextBlock Text="Your next session" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,17"/>
      <Border Background="#1D231B" CornerRadius="18" Padding="24">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="CowClient" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="SessionInfo" Text="Minecraft 1.21.11  ·  Fabric  ·  4 GB RAM" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,9,0,0"/></StackPanel>
        <Button x:Name="LaunchButton" Grid.Column="1" Content="Launch Minecraft  →" Width="238" Height="46" Background="#C3ED91" Foreground="#172114" Click="Launch_Click"/>
       </Grid>
      </Border>
     </StackPanel>
    </Grid>
    <ScrollViewer x:Name="ProfilesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="A setup for every session." FontSize="30" FontWeight="SemiBold"/>
      <TextBlock Text="These profiles control your CowClient modules. Your worlds stay in one 1.21.11 instance." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,13,0,28"/>
      <Border Background="#20271D" CornerRadius="18" Padding="24" Margin="0,0,0,16"><Grid><StackPanel><TextBlock Text="Default" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="FPS, CPS, keystrokes, ping and smooth zoom." Foreground="{StaticResource Muted}" Margin="0,10,135,0" TextWrapping="Wrap"/></StackPanel><Button Content="Use Default" Tag="Default" Click="Profile_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
      <Border Background="#20271D" CornerRadius="18" Padding="24" Margin="0,0,0,16"><Grid><StackPanel><TextBlock Text="Competitive" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Add armor, speed and a steadier camera." Foreground="{StaticResource Muted}" Margin="0,10,165,0" TextWrapping="Wrap"/></StackPanel><Button Content="Use Competitive" Tag="Competitive" Click="Profile_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
      <Border Background="#20271D" CornerRadius="18" Padding="24"><Grid><StackPanel><TextBlock Text="Chill" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Coordinates and clock, with less HUD clutter." Foreground="{StaticResource Muted}" Margin="0,10,145,0" TextWrapping="Wrap"/></StackPanel><Button Content="Use Chill" Tag="Chill" Click="Profile_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
      <TextBlock Text="Press Right Shift in-game to customize. Your changes are saved per profile." Margin="0,24,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,0,12,20">
      <TextBlock Text="Make it yours." FontSize="30" FontWeight="SemiBold" Margin="0,0,0,25"/>
      <Border CornerRadius="18" Background="#20271D" Padding="24">
       <StackPanel>
        <TextBlock Text="Minecraft memory" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="RamLabel" Text="4096 MB" Foreground="#C3ED91" Margin="0,12,0,0"/>
        <Slider x:Name="RamSlider" Minimum="2048" Maximum="8192" TickFrequency="512" IsSnapToTickEnabled="True" Value="4096" ValueChanged="Ram_Changed" Margin="0,12,0,16"/>
        <TextBlock Text="4 GB is a sensible starting point for a 16 GB PC." Foreground="{StaticResource Muted}" FontSize="12"/>
        <CheckBox x:Name="PerformanceCheck" Content="Install Sodium and Lithium for this instance"/>
        <CheckBox x:Name="MinimizeCheck" Content="Minimize CowClient when Minecraft starts"/>
       </StackPanel>
      </Border>
      <Border CornerRadius="18" Background="#20271D" Padding="24" Margin="0,18,0,0">
       <StackPanel>
        <TextBlock Text="Microsoft application setup" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="CowClient needs its own registered public-client application ID. This is not your password or a client secret." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,15"/>
        <TextBox x:Name="ClientIdBox" ToolTip="CowClient Microsoft application (client) ID"/>
        <Button Content="Read sign-in setup" Click="AuthDocs_Click" HorizontalAlignment="Left" Margin="0,13,0,0"/>
       </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
       <Button Content="Save settings" Background="#C3ED91" Foreground="#172114" Click="Save_Click"/>
       <Button Content="Sign out" Margin="12,0,0,0" Click="Logout_Click"/>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </Grid>
   <Grid Grid.Row="2" Margin="36,15,36,15">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="StatusText" Text="An owned copy of Minecraft Java is required." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" MaxHeight="44"/><ProgressBar x:Name="Progress" Height="3" Margin="0,10,16,0" Maximum="1" Foreground="#C3ED91" Background="#283121" Visibility="Collapsed"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="0.1.0-alpha" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/><Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Margin="0,7,0,0" Padding="10,6" FontSize="12" Click="Cancel_Click"/></StackPanel>
   </Grid>
  </Grid>
  <Border x:Name="LoginOverlay" Grid.ColumnSpan="2" Background="#D9101310" Visibility="Collapsed">
   <Border Width="510" Background="#20271D" CornerRadius="22" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel>
     <TextBlock Text="Sign in with Microsoft" FontSize="27" FontWeight="SemiBold"/>
     <TextBlock Text="Open Microsoft's website and enter this code. Only continue if this launcher started the sign-in." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,16,0,22"/>
     <TextBox x:Name="DeviceCodeBox" IsReadOnly="True" FontSize="32" FontWeight="SemiBold" TextAlignment="Center"/>
     <Button Content="Open Microsoft sign-in" Click="Browser_Click" Background="#C3ED91" Foreground="#172114" Margin="0,23,0,0"/>
     <Button Content="Cancel sign-in" Click="Cancel_Click" Background="Transparent" Margin="0,10,0,0"/>
    </StackPanel>
   </Border>
  </Border>
 </Grid>
 </Border>
</Window>
